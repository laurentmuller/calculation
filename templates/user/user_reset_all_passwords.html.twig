{% extends 'cards/card_delete.html.twig' %}
{% from 'macros/_icons.html.twig' import button %}
{# macros #}
{% macro action(id, icon) %}
    <li>
        {{ button(
            text: 'user.reset_all.actions.' ~ id,
            class: 'dropdown-item',
            icon: icon,
            inline: false,
            attributes: {id: id}) }}
    </li>
{% endmacro action %}
{# parameters #}
{%- set title = 'user.reset_all.title' -%}
{%- set title_icon = ICON_DELETE -%}
{%- set form_attr = form_attr|default({})|merge({'data-error': 'user.reset_all.error'|trans}) -%}
{# body #}
{% block card_body %}
<p>{{ 'user.reset_all.confirmation'|trans }}</p>
{{ form_row(form.users) }}
{{ parent() }}
{%- endblock card_body %}
{# actions form #}
{% block actions_form -%}
    {{ parent() }}
    {{ button(
        text: 'common.actions',
        class: 'btn btn-outline-secondary dropdown-toggle',
        icon: 'fa-solid fa-bars',
        attributes: {
            'data-bs-toggle': 'dropdown',
            'aria-expanded': false}) }}
        <ul class="dropdown-menu">
            {{ _self.action('all', 'fa-fw fa-solid fa-check-circle') }}
            {{ _self.action('none', 'fa-fw fa-solid fa-times-circle') }}
            {{ _self.action('toggle', 'fa-fw fa-solid fa-right-left') }}
        </ul>
{%- endblock actions_form %}
{# javascript #}
{% block javascripts %}
{{ parent() }}
{{ asset_js('js/application/user_reset_all_passwords.js') }}
{% endblock javascripts %}
