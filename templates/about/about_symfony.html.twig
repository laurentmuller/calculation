{% extends 'cards/card_base.html.twig' %}
{# import #}
{% from 'macros/_icons.html.twig' import homepage, link, link_pdf, link_excel %}
{% from 'about/_about_macro.html.twig' import item_link_php, item_link_database %}
{# parameters #}
{%- set title = 'about.symfony.title' -%}
{%- set title_icon = 'fa-brands fa-symfony' -%}
{# class #}
{% block card_container_class '' %}
{% block card_header_class ' d-flex-wrap-center' %}
{# card title #}
{% block card_title %}
    {{ parent() }}
    {{ link_pdf('about_database_pdf') }}
    {{ link_excel('about_symfony_excel') }}
{%- endblock card_title %}
{# card body #}
{% block card_body -%}
    <div id="aboutAccordion">
        {{ include('about/symfony_content.html.twig') }}
    </div>
{% endblock card_body %}
{# card footer #}
{% block card_footer -%}
    {{ parent() }}
    {{ homepage() }}
    <div class="btn-group">
        {{ link(
            href: path('about_index'),
            text: 'about.title',
            class: 'btn btn-outline-secondary',
            icon: 'fa-solid fa-info-circle',
            inline: true,
        ) }}
        <button type="button" class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split"
                data-bs-toggle="dropdown" aria-expanded="false">
            <span class="visually-hidden">{{ 'common.toggle'|trans }}</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            {{ item_link_php() }}
            {{ item_link_database() }}
        </ul>
    </div>
{%- endblock card_footer %}
{# stylesheets #}
{% block stylesheets %}
    {{ asset_css('css/phpinfo.css') }}
{% endblock stylesheets %}
{# javascripts #}
{% block javascripts %}
    {% if is_js_debug %}
        {{ parent() }}
        {{ asset_js('build/clipboard/clipboard.js') }}
        {{ asset_js('build/jquery-contextmenu/jquery.contextMenu.js') }}
        {{ asset_js('build/jquery-contextmenu/jquery.ui.position.js') }}
        {{ asset_js('js/extensions/contextmenu-extensions.js') }}
        {{ asset_js('js/plugins/plugin-rowlink.js') }}
        {{ asset_js('js/plugins/plugin-copy.js') }}
        {{ asset_js('js/application/about_index.js') }}
        {{ asset_js('js/application/about_advanced.js') }}
    {%- else -%}
        {{ asset_js('js/compiled/about_advanced.js') }}
    {%- endif -%}
{% endblock javascripts %}
