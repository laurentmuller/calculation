--TEST--
"role_icon_name" filter test
--TEMPLATE--
{{ webmaster|role_icon_name|raw }}
{{ admin|role_icon_name|raw }}
{{ user|role_icon_name|raw }}
--DATA--
return [
    'webmaster' => 'ROLE_WEBMASTER',
    'admin' => 'ROLE_ADMIN',
    'user' => 'ROLE_USER'
]
--EXPECT--
<i class="fa-solid fa-user-gear me-1"></i>user.roles.webmaster
<i class="fa-solid fa-user-shield me-1"></i>user.roles.admin
<i class="fa-solid fa-user me-1"></i>user.roles.user
