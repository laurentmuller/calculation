{% extends '@email/default/notification/body.txt.twig' %}
{% block lead %}
{{ email.subject }} - {{ importance_title }}
{% endblock lead %}
{# content #}
{% block content %}
{{ content|html_to_markdown }}
{% endblock content %}
{# action #}
{% block action %}
{% if signature %}
