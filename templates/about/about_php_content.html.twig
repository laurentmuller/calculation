{% from 'macros/_icons.html.twig' import linkExternal %}
{% from 'about/_about_macro.html.twig' import headerLink %}
{# macros #}
{% macro output_module_id(module) -%}
    {{- module.name|lower|url_encode -}}
{%- endmacro output_module_id %}

{% macro output_module_entry(module) -%}
    <tr>
        <td class="position-relative">
            <a class="d-flex-center stretched-link text-body" href="#{{ _self.output_module_id(module) }}">
                {%- if module.url -%}
                    <i class="fa-solid fa-plug-circle-plus me-1"></i>
                {% else %}
                    <i class="fa-solid fa-circle-info me-1"></i>
                {%- endif -%}
                <span class="me-auto">{{- module.name -}}</span>
                {%- if module.size -%}
                    <span class="badge rounded-pill text-bg-secondary">{{ module.size }}</span>
                {%- endif %}
            </a>
        </td>
    </tr>
{%- endmacro output_module_entry %}

{% macro output_module_content(module) -%}
    <div id="{{ _self.output_module_id(module) }}" class="d-flex-center py-1 border-bottom">
        <h1 class="flex-fill pb-1">{{ module.name }}</h1>
        {% if module.url %}
            {{- linkExternal(
                href: module.url,
                text: null,
                icon: 'fa-solid fa-arrow-up-right-from-square',
                title: 'about.php.link_doc',
            ) -}}
        {% endif %}
    </div>
    {% for group in module.groups %}
        {{ _self.output_group_content(group) }}
        {{ _self.output_group_configs(group) }}
    {% endfor %}
{%- endmacro output_module_content %}

{% macro output_group_content(group) -%}
    {% if group.name %}
        <div class="my-1 fw-bold">{{ group.name }}</div>
    {% endif %}
    {% if group.note %}
        <div class="mt-1 p-2 bg-body-tertiary small">{{ group.note|nl2br }}</div>
    {% endif %}
{%- endmacro output_group_content %}

{% macro output_group_configs(group) %}
    <table class="table table-sm table-hover">
        {% if group.headers %}
            <thead>
            <tr>
                {% for header in group.headers %}
                    <th class="{{ loop.index0 === 0 ? 'e' : 'v' }}">{{ header }}</th>
                {% endfor %}
            </tr>
            </thead>
        {% endif %}
        <tbody>
        {% for config in group.configs %}
            <tr>
                <td class="e">{{ config.name }}</td>
                <td {{ _self.output_entry_attr(config.local, config.master) }}>{{- config.local.value|raw -}}</td>
                {% if config.master %}
                    <td {{ _self.output_entry_attr(config.master, true) }}>{{- config.master.value|raw -}}</td>
                {% endif %}
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endmacro output_group_configs %}

{% macro output_entry_attr(entry, master = null) -%}
    {{- html_attr({
        colspan: master ? null : 2,
        class: [
            'v',
            entry.type === constant('App\\Service\\PhpInfoService::TYPE_DISABLED') ? 'disabled' : null,
            entry.type === constant('App\\Service\\PhpInfoService::TYPE_ENABLED') ? 'enabled' : null,
            entry.type === constant('App\\Service\\PhpInfoService::TYPE_NO_VALUE') ? 'text-secondary fst-italic' : null,
            entry.type === constant('App\\Service\\PhpInfoService::TYPE_NONE_VALUE') ? 'text-secondary' : null,
            entry.type === constant('App\\Service\\PhpInfoService::TYPE_REDACTED') ? 'text-secondary' : null,
        ],
        style: {
            color: entry.type === constant('App\\Service\\PhpInfoService::TYPE_COLOR') ? entry.value : null,
        },
    }) -}}
{%- endmacro output_entry_attr %}

{# content #}
<div class="about">
    {{ headerLink('php.net', info.version, 'php') }}
    <div class="row g-2">
        <div class="col-md-4 col-lg-2 col-12 php-list-spy border-end d-print-none">
            <table class="table table-sm table-hover">
                <tbody>
                {% for module in info.modules %}
                    {{ _self.output_module_entry(module) }}
                {% endfor %}
                </tbody>
            </table>
        </div>
        {%- set attrs = {
            class: 'col-md-8 col-lg-10 col-12 php-content-spy php-spy-content',
            'data-bs-target': '.php-list-spy',
            'data-bs-spy': 'scroll',
            tabindex: 0,
        } -%}
        <div {{ html_attr(attrs) }}>
            {% for module in info.modules %}
                {{ _self.output_module_content(module) }}
            {% endfor %}
        </div>
    </div>
</div>
