{% from 'macros/_icons.html.twig' import dropdownEllipsis, dropdownItemWithClass, dropdownSeparator, dropdownItem, dropdownItemExternal %}
{{ dropdownEllipsis() }}
<ul class="dropdown-menu dropdown-menu-end dropdown-menu-actions">
    {%- if edit_page -%}
        {% set item_class = row_edit and is_editable ? 'btn-default' : '' %}
        {{ dropdownItemWithClass(path(edit_page, params), 'calculation.edit.title_short', ICON_EDIT, item_class) }}
    {%- endif -%}
    {%- if state_page -%}
        {% set item_class = row_edit and not is_editable ? 'btn-default' : '' %}
        {{ dropdownItemWithClass(path(state_page, params), 'calculation.list.state_title', ICON_CALCULATION_STATE, item_class) }}
    {%- endif -%}
    {%- if add_page -%}
        {{- dropdownSeparator() }}
        {{ dropdownItem(path(add_page, params), 'calculation.add.title', ICON_ADD) }}
        {{ dropdownItem(path(clone_page, params), 'common.button_clone', ICON_COPY) }}
    {%- endif -%}
    {%- if delete_page -%}
        {{- dropdownSeparator() }}
        {{ dropdownItemWithClass(path(delete_page, params), 'calculation.delete.title', ICON_DELETE, 'btn-delete') }}
    {%- endif -%}
    {%- if show_page -%}
        {{- dropdownSeparator() }}
        {% set item_class = row_show ? 'btn-default' : '' %}
        {{ dropdownItemWithClass(path(show_page, params), 'calculation.show.title', ICON_SHOW, item_class) }}
    {%- endif -%}
    {%- if single_page_pdf or single_page_excel -%}
        {{- dropdownSeparator() }}
        {%- if single_page_pdf -%}
            {{ dropdownItemExternal(path(single_page_pdf, {id: id}), 'calculation.list.pdf_single_title', ICON_PDF) }}
        {% endif %}
        {%- if single_page_excel -%}
            {{ dropdownItemExternal(path(single_page_excel, {id: id}), 'calculation.list.excel_single_title', ICON_EXCEL) }}
        {% endif %}
    {%- endif -%}
</ul>
