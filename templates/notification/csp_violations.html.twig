{% extends 'notification/notification.html.twig' %}

{% macro output_row(key, value) %}
    <row class="collapse">
        <columns small="6" large="3" class="pb-4">{{ key }}</columns>
        <columns small="6" large="9" class="pb-4">{{ value }}</columns>
    </row>
{% endmacro output_row %}

{% block content %}
    <container>
        <row class="collapse">
            <columns>{{ 'notification.csp_description'|trans({'%name%': app_name}) }}</columns>
        </row>
    </container>
    <container>
        <row class="collapse">
            <columns class="pb-0"><b>Violations :</b></columns>
        </row>
    </container>
    {% for entry in entries %}
        <hr/>
        <container>
            {{ _self.output_row('type', entry.type ?? 'Unknown') }}
            {{ _self.output_row('url', entry.url ?? 'Unknown') }}
            {% if entry.body and entry.body|length %}
                {% for key, value in entry.body %}
                    {{ _self.output_row(key, value) }}
                {% endfor %}
            {% endif %}
        </container>
    {% endfor %}
{% endblock content %}
