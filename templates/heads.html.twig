{# meta-data #}
<meta charset="utf-8"/>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="application-name" content="{{ app_name }}">
<meta name="description" content="{{ app_description }}">
<meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#212529" media="(prefers-color-scheme: dark)">
<meta name="msapplication-TileColor" content="#212529">
<meta name="msapplication-TileImage" content="{{ asset_icon(96) }}">
<meta name="msapplication-config" content="{{ asset('browserconfig.xml') }}"/>
<meta property="og:title" content="{{ title_text }}"/>
<meta property="og:image" content="{{ asset_icon(96) }}"/>
<meta property="og:url" content="{{ app.request.uri }}"/>
<meta property="og:description" content="{{ app_description }}">
<meta property="og:type" content="website"/>
{# icons #}
<link rel="icon" type="image/png" sizes="96x96" href="{{ asset_icon(96) }}">
<link rel="icon" type="image/svg+xml" href="{{ asset('images/icons/favicon.svg') }}">
<link rel="apple-touch-icon" sizes="180x180" href="{{ asset_icon(180) }}">
<link rel="shortcut icon" href="{{ asset('images/icons/favicon.ico') }}">
{# manifest #}
<link rel="manifest" type="application/manifest+json" href="{{ asset('site.webmanifest') }}">
