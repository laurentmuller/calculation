{# macros #}
{% macro card(id, title, pdf_route, excel_route = false, word_route = false) -%}
    {% from 'macros/_icons.html.twig' import link_pdf, link_word, link_excel %}
    <div class="card-header d-flex-wrap-center">
        <a class="drop-down-icon-left card-title" href="#{{ id }}" data-bs-toggle="collapse"
           aria-expanded="false" title="{{ 'common.expand'|trans }}">
            {{- title|trans -}}
        </a>
        {{ link_pdf(pdf_route, 'fa-fw') }}
        {% if excel_route %}
            {{ link_excel(excel_route, 'fa-fw') }}
        {% endif %}
        {% if word_route %}
            {{ link_word(word_route, 'fa-fw') }}
        {% endif %}
    </div>
    <div class="card-body collapse" id="{{ id }}" data-bs-parent="#aboutAccordion">
        <div class="collapse-content" data-url="{{ path('about_' ~ id ~ '_content') }}">
            <div class="alert py-0 mb-0" role="alert">
                <span class="spinner-border spinner-border-sm me-2"
                      role="status"></span><span>{{ 'about.load.message'|trans }}</span>
            </div>
        </div>
    </div>
{%- endmacro card %}

{% macro headerInfo(name) -%}
    <tr class="h">
        <th class="fw-bold" colspan="2">{{ name }}</th>
    </tr>
{%- endmacro headerInfo %}

{% macro rowInfo(name, value, name_class = '', value_class = '') -%}
    {%- set name_class = ('e ' ~ name_class|default)|trim -%}
    {%- set value_class = ('v ' ~ value_class|default)|trim -%}
    <tr>
        <td class="{{ name_class }}">{{ name }}</td>
        <td class="{{ value_class }}">{{- value -}}</td>
    </tr>
{%- endmacro rowInfo %}

{% macro rowInfoLink(name, value, href, name_class = '', value_class = '') -%}
    {%- set name_class = ('e ' ~ name_class|default)|trim -%}
    {%- set value_class = ('v ' ~ value_class|default)|trim -%}
    <tr>
        <td class="{{ name_class }}">{{ name }}</td>
        <td class="{{ value_class }}">
            <a href="{{ href }}" class="card-link" target="_blank" rel="noopener noreferrer">{{- value -}}</a>
        </td>
    </tr>
{%- endmacro rowInfoLink %}

{% macro rowInfoBoolean(name, value, enabled = null) -%}
    {%- if enabled is null -%}
        {%- set enabled = value -%}
        {%- set value = value|boolean -%}
    {%- endif -%}
    {%- set class = enabled ? 'enabled' : 'disabled' -%}
    <tr>
        <td class="e">{{ name }}</td>
        <td class="v {{ class }}">{{ value }}</td>
    </tr>
{%- endmacro rowInfoBoolean %}

{% macro headerLink(url, version, icon) -%}
    {% set attrs = {
        href: 'https://' ~ url,
        class: 'h1 d-flex flex-column',
        title: 'about.link_homepage'|trans,
        target: '_blank',
        rel: 'noopener noreferrer',
    } %}
    <div class="border-bottom pb-1">
        <a {{ html_attr(attrs) }}>
            {{- source('about/' ~ icon ~ '.svg') -}}
            <span>{{ 'about.version'|trans({'%version%': version}) -}}</span>
        </a>
    </div>
{%- endmacro headerLink %}

{% macro about_link() %}
    {% from 'macros/_icons.html.twig' import link %}
    {{ link(
        href: path('about_index'),
        text: 'about.title',
        title: 'footer.about_title',
        class: 'btn btn-outline-secondary',
        icon: 'fa-solid fa-info-circle',
        inline: true,
    ) }}
{%- endmacro about_link %}

{% macro button_toggle_split() %}
    {% set attrs = {
        type: 'button',
        class: 'btn btn-outline-secondary dropdown-toggle dropdown-toggle-split',
        title: 'about.advanced.title'|trans,
        'data-bs-toggle': 'dropdown',
        'data-bs-reference': 'parent',
        'aria-expanded': false,
    } %}
    <button {{ html_attr(attrs) }}>
        <span class="visually-hidden">{{ 'common.toggle'|trans }}</span>
    </button>
{%- endmacro button_toggle_split -%}

{% macro item_link_symfony() %}
    {% from 'macros/_icons.html.twig' import link %}
    <li>
        {{- link(
            href: path('about_symfony_index'),
            text: 'about.symfony.title',
            class: 'dropdown-item',
            icon: 'fa-brands fa-symfony') -}}
    </li>
{%- endmacro item_link_symfony %}

