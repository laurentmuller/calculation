<div class="row justify-content-between">
    <div class="col-md-8 h5">{{ package.name }}</div>
    <div class="col-md-4 text-md-end">Version : {{ package.version }}</div>
</div>
<div class="row justify-content-between">
    <div class="col-md-8">License : {{ package.licenseType|join(', ') }}</div>
    <div class="col-md-4 text-md-end">Date : {{ package.time }}</div>
</div>
<hr>
{% if package.production|length %}
    <p>{{ enum('App\\Enums\\Environment')?.PRODUCTION|trans }}</p>
    <ul>
        {% for key, value in package.production %}
            <li>{{ key }} : <code>{{ value }}</code></li>
        {% endfor %}
    </ul>
{% endif %}
{% if package.development|length %}
    <p>{{ enum('App\\Enums\\Environment')?.DEVELOPMENT|trans }}</p>
    <ul>
        {% for key, value in package.development %}
            <li>{{ key }} : <code>{{ value }}</code></li>
        {% endfor %}
    </ul>
{% endif %}
