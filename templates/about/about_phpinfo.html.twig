{% extends 'cards/card_base.html.twig' %}
{%- set title = 'about.php.title' -%}
{%- set title_icon = 'fa-brands fa-php' -%}
{% block card_container_class '' %}
{% block card_footer_class ' d-none' %}

{% macro output_class(entry) -%}
    {%- if entry.enabled -%}
        v enabled
    {%- elseif entry.disabled -%}
        v disabled
    {%- elseif entry.redacted -%}
        v text-secondary
    {%- elseif entry.no_value -%}
        v text-secondary fst-italic
    {%- else -%}
        v
    {%- endif -%}
{%- endmacro output_class %}

{% macro output_style(entry) -%}
    {% if entry.color %}
        style="color: {{ entry.value }}"
    {% endif %}
{%- endmacro output_style %}

{% block card_body %}
    <div class="phpversion">
        <div class="border-bottom pb-1">
            <a href="https://php.net" target="_blank" rel="noopener noreferrer"
               title="{{ 'about.link_homepage'|trans }}" class="h1 d-flex flex-column">
                {{- source('about/php.svg') }}
                <span>{{ 'about.version'|trans({'%version%': info.version}) -}}</span>
            </a>
        </div>
        {% for module in info.modules %}
            <h5 class="my-2">{{ module.name }}</h5>
            {% for group in module.groups %}
                {% if group.name %}
                    <h6 class="my-2">{{- group.name }}</h6>
                {% endif %}
                {% if group.note %}
                    <div class="p-2 bg-body-tertiary small">{{ group.note }}</div>
                {% endif %}
                <table class="table table-sm table-hover">
                    {% if group.headings %}
                        <thead>
                            <tr>
                                {% for heading in group.headings %}
                                    <th>{{ heading }}</th>
                                {% endfor %}
                            </tr>
                        </thead>
                    {% endif %}
                    <tbody>
                    {% for config in group.configs %}
                        <tr>
                            <td class="e">{{ config.name }}</td>
                            {% if config.master %}
                                <td class="{{- _self.output_class(config.local) -}}" {{ _self.output_style(config.local) }}>
                                    {{- config.local.value -}}
                                </td>
                                <td class="{{- _self.output_class(config.master) -}}" {{ _self.output_style(config.master) }}>
                                    {{- config.master.value -}}
                                </td>
                            {% else %}
                                <td class="{{- _self.output_class(config.local) -}}" {{ _self.output_style(config.local) }} colspan="2">
                                    {{- config.local.value -}}
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% endfor %}
        {% endfor %}
    </div>
{% endblock card_body %}
{% block stylesheets %}
    {{ asset_css('css/phpinfo.css') }}
{% endblock stylesheets %}
