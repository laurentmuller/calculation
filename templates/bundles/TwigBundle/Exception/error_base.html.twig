{% extends 'cards/card_base.html.twig' %}
{# imports #}
{% from 'macros/_icons.html.twig' import link, homepage, button_copy %}
{# macros #}
{% macro header(name, value) -%}
    <tr>
        <th>{{ name|trans }}</th>
        <th>{{ value|trans }}</th>
    </tr>
{% endmacro header %}
{% macro row(id, text) -%}
    <tr>
        <td>{{ id|trans }}</td>
        <td>{{ text }}</td>
    </tr>
{% endmacro row %}
{% macro trace(index, trace) -%}
    <tr>
        <td>{{ index }}</td>
        <td>
            {%- if trace.file -%}
                <span class="me-1">{{ trace.file|relative_path }}</span>
            {%- endif -%}
            {%- if trace.short_class|default -%}
                <span class="text-warning">{{ trace.short_class }}</span>
            {%- endif -%}
            {%- if trace.type|default -%}
                <span class="text-body-secondary">{{ trace.type }}</span>
            {%- endif -%}
            {%- if trace.function|default -%}
                <span class="text-danger me-1">{{ trace.function }}</span>
            {%- endif -%}
            {%- if trace.line|default -%}
                <span class="text-body-secondary">
                    {{- 'error_page.fields.line_number'|trans({'%line%': trace.line}) -}}
                </span>
            {%- endif -%}
        </td>
    </tr>
{% endmacro trace %}
{# parameters #}
{%- set title_icon = 'fa-solid fa-exclamation-circle' -%}
{% set status_code = status_code|default(0) %}
{% if not title is defined %}
    {% if status_code != 0 %}
        {%- set title = 'error_page.title' -%}
        {%- set title_parameters = {'%status_code%': status_code} -%}
    {% else %}
        {%- set title = 'error_page.default_title' -%}
    {% endif %}
{% endif %}
{%- set title_description = 'error_page.description' -%}
{%- set is_exception = exception ?? false -%}
{# class #}
{% block card_class ' border-danger' %}
{% block card_header_class ' text-bg-danger' %}
{% block card_container_class is_exception ? '' : ' col-xl-8 offset-xl-2' %}
{# body #}
{% block card_body %}
    <p id="error-message">
        {% block error_message -%}
            {{- description|default|raw }} {{ suggestion|default|raw -}}
        {%- endblock error_message %}
    </p>
    <div class="d-flex-wrap-center d-print-none">
        <span class="me-auto">{{ 'error_page.link'|trans({'%path%': path('user_comment')})|raw }}</span>
        {% if is_exception %}
            {%- set attrs = {
                class: ['drop-down-icon-right', 'text-end'],
                href: '#exception-detail',
                'data-bs-toggle': 'collapse',
                'aria-controls': 'exception-detail',
                'aria-expanded': 'false'} -%}
            <a {{ html_attr(attrs) }}>{{- 'error_page.details'|trans -}}</a>
        {% endif %}
    </div>
    {% if is_exception %}
        <div id="exception-detail" class="collapse border-top mt-3">
            <table id="exception-table" class="table table-exception table-no-end-line table-sm mb-0">
                <thead>
                {{ _self.header('error_page.fields.property', 'error_page.fields.value') }}
                </thead>
                <tbody>
                {{ _self.row('error_page.fields.message', exception.message) }}
                {% if exception.code|default %}
                    {{ _self.row('error_page.fields.code', exception.code) }}
                {% endif %}
                {% if exception.file|default %}
                    {{ _self.row('error_page.fields.file', exception.file|relative_path) }}
                {% endif %}
                {% if exception.line|default %}
                    {{ _self.row('error_page.fields.line', exception.line) }}
                {% endif %}
                {{ _self.header('error_page.fields.trace', 'error_page.fields.call') }}
                {% set traces = traces|default(exception.trace|default({})) %}
                {% for trace in traces %}
                    {{ _self.trace(loop.index0, trace) }}
                {% else %}
                    <tr>
                        <td colspan="2">{{ 'error_page.no_trace'|trans }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock card_body %}
{# footer #}
{% block card_footer %}
    {% if page_list ?? false %}
        {{ link(
            href: cancel_url(app.request, id|default(null), page_list),
            text: 'common.button_back_list',
            class: 'btn btn-form btn-primary',
            icon: 'fa-solid fa-chevron-left',
            inline: true) }}
    {% else %}
        {{ homepage() }}
    {% endif %}
    {{ button_copy(target: false) }}
{% endblock card_footer %}
{# javascripts #}
{% block javascripts %}
    {{ parent() }}
    {{ asset_js('build/clipboard/clipboard.js') }}
    {{ asset_js('js/plugins/plugin-copy.js') }}
    {{ asset_js('js/application/error_base.js') }}
{% endblock javascripts %}
