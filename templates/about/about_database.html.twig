{% extends 'cards/card_base.html.twig' %}
{# import #}
{% from 'macros/_icons.html.twig' import homepage, link_pdf, link_excel %}
{% from 'about/_about_macro.html.twig' import about_link, button_toggle_split, item_link_symfony, item_link_php %}
{# parameters #}
{%- set title = 'about.database.title' -%}
{%- set title_icon = 'fa-solid fa-database' -%}
{# class #}
{% block container_class 'container-fluid' %}
{% block card_container_class '' %}
{% block card_header_class ' d-flex-wrap-center' %}
{# card title #}
{% block card_title %}
    {{ parent() }}
    {{ link_pdf('about_database_pdf') }}
    {{ link_excel('about_database_excel') }}
{%- endblock card_title %}
{# card body #}
{% block card_body -%}
    {% set attrs = {
        id: 'configuration',
        'data-collapse': 'common.collapse'|trans,
        'data-expand': 'common.expand'|trans,
        'data-error': 'about.load.error'|trans,
    } %}
    <div {{ html_attr(attrs) }}>
        <div id="aboutAccordion">
            {{ include('about/content_database.html.twig') }}
        </div>
    </div>
{% endblock card_body %}
{# card footer #}
{% block card_footer -%}
    {{ parent() }}
    {{ homepage() }}
    <div class="btn-group">
        {{ about_link() }}
        {{ button_toggle_split() }}
        <ul class="dropdown-menu">
            {{ item_link_symfony() }}
            {{ item_link_php() }}
        </ul>
    </div>
{%- endblock card_footer %}
{# stylesheets #}
{% block stylesheets %}
    {{ asset_css('css/phpinfo.css') }}
{% endblock stylesheets %}
{# javascripts #}
{% block javascripts %}
    {% if is_js_debug %}
        {{ parent() }}
        {{ asset_js('build/clipboard/clipboard.js') }}
        {{ asset_js('js/plugins/plugin-copy.js') }}
        {{ asset_js('js/application/about_index.js') }}
    {%- else -%}
        {{ asset_js('js/compiled/about_index.js') }}
    {%- endif -%}
{% endblock javascripts %}
