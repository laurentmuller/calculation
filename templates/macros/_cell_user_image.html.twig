{%- set image = asset_image_user(user, 32, {
    class: 'rounded-circle',
    title: 'user.image.title'|trans,
    alt: 'user.fields.imageFile'|trans}) -%}
{%- if image -%}
    {{- image|raw -}}
{%- else -%}
    <span class="badge rounded-circle text-bg-secondary user-image-empty">{{ user.initials }}</span>
{%- endif -%}
