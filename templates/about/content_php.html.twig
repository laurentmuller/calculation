{% from 'macros/_icons.html.twig' import linkExternal %}
{% from 'about/_about_macro.html.twig' import headerLink %}
{# macros #}
{% macro output_entry_attr(entry, master = null) -%}
    {{- html_attr({
        colspan: master ? 2 : null,
        class: [
            'v',
            entry.type === constant('App\\Service\\PhpInfoService::TYPE_DISABLED') ? 'disabled' : null,
            entry.type === constant('App\\Service\\PhpInfoService::TYPE_ENABLED') ? 'enabled' : null,
            entry.type === constant('App\\Service\\PhpInfoService::TYPE_NO_VALUE') ? 'text-secondary fst-italic' : null,
            entry.type === constant('App\\Service\\PhpInfoService::TYPE_NONE_VALUE') ? 'text-secondary' : null,
            entry.type === constant('App\\Service\\PhpInfoService::TYPE_REDACTED') ? 'text-secondary' : null,
        ],
        style: {
            color: entry.type === constant('App\\Service\\PhpInfoService::TYPE_COLOR') ? entry.value : null,
        },
    }) -}}
{%- endmacro output_entry_attr %}
{% macro output_group_configs(group) %}
    <table class="table table-sm table-hover">
        {% if group.headers %}
            <thead>
            <tr>
                {% for header in group.headers %}
                    <th class="{{ loop.index0 === 0 ? 'e' : 'v' }}">{{ header }}</th>
                {% endfor %}
            </tr>
            </thead>
        {% endif %}
        <tbody>
        {% for config in group.configs %}
            <tr>
                <td class="e">{{ config.name }}</td>
                <td {{ _self.output_entry_attr(config.local, config.master) }}>{{- config.local.value|raw -}}</td>
                {% if config.master %}
                    <td {{ _self.output_entry_attr(config.master) }}>{{- config.master.value|raw -}}</td>
                {% endif %}
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endmacro output_group_configs %}
{# content #}
<div class="phpversion">
    {{ headerLink('php.net', info.version, 'php') }}
    <div class="row g-2">
        <div id="php-list-spy" class="col-2 php-spy-content scrollbar-thin">
            {% for module in info.modules %}
                <div class="d-flex justify-content-between align-items-start position-relative border-bottom p-1">
                    <a class="php-spy-link stretched-link text-body pe-3" href="#php-item-{{ loop.index }}">
                        {{- module.name -}}
                    </a>
                    {% if module.size -%}
                        <span class="badge rounded-pill text-bg-secondary">{{ module.size }}</span>
                    {%- endif %}
                </div>
            {% endfor %}
        </div>
        {% set attrs = {
            class: 'col-10 php-spy-content scrollbar-thin',
            'data-bs-spy': 'scroll',
            'data-bs-target': '#php-list-spy',
            tabindex: 0,
        } %}
        <div {{ html_attr(attrs) }}>
            {% for module in info.modules %}
                <div id="php-item-{{ loop.index }}" class="d-flex align-items-center py-1 border-bottom">
                    <h1 class="flex-fill pb-1">{{ module.name }}</h1>
                    {% if module.url %}
                        {{- linkExternal(
                            href: module.url,
                            text: null,
                            icon: 'fa-solid fa-arrow-up-right-from-square',
                            title: 'about.php.link_doc',
                        ) -}}
                    {% endif %}
                </div>
                {% for group in module.groups %}
                    {% if group.name %}
                        <div class="my-1 fw-bold">{{ group.name }}</div>
                    {% endif %}
                    {% if group.note %}
                        <div class="mt-1 p-2 bg-body-tertiary small">{{ group.note|nl2br }}</div>
                    {% endif %}
                    {{ _self.output_group_configs(group) }}
                {% endfor %}
            {% endfor %}
        </div>
    </div>
</div>
