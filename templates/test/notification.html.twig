{% extends 'cards/card_base.html.twig' %}
{% from 'macros/_icons.html.twig' import button, homepage %}
{# macros #}
{% macro button_notify(type, icon) -%}
    {% set text = 'background.' ~ type %}
    {% set title = '<i class="me-1 ' ~ icon ~ '"></i>' ~ 'test.notification'|trans %}
    {% set content = 'Affiche une notification de type <b>' ~ text|trans ~ '</b> avec des données aléatoires.' %}
    <div class="col">
        {{ button(
            text: text,
            class: ['btn', 'btn-notify', 'btn-' ~ type, 'w-100'],
            icon: icon,
            inline: false,
            attributes: {
                'data-type': type,
                'data-bs-html': true,
                'data-bs-title': title,
                'data-bs-trigger': 'hover',
                'data-bs-toggle': 'popover',
                'data-bs-placement': 'top',
                'data-bs-content': content,
                'data-bs-custom-class': 'popover-' ~ type,
            }) }}
    </div>
{%- endmacro button_notify %}

{% macro position(position, selection) -%}
    {% set attrs = {
        value: position.value,
        selected: position == selection} %}
    <option {{ html_attr(attrs) }}>{{ position|trans }}</option>
{%- endmacro position %}

{% macro timeout(seconds, selection) -%}
    {% set attrs = {
        value: seconds * 1000,
        selected: seconds * 1000 == selection} %}
    <option {{ html_attr(attrs) }}>{{ 'counters.seconds'|trans({'%count%': seconds}) }}</option>
{%- endmacro timeout %}

{% macro progress(pixels, selection) -%}
    {% set attrs = {
        value: pixels,
        selected: pixels == selection} %}
    <option {{ html_attr(attrs) }}>{{ 'counters.pixels'|trans({'%count%': pixels}) }}</option>
{%- endmacro progress %}

{% macro checkbox(id, text, checked = true) -%}
    <div class="form-check form-check-inline form-switch form-check-option">
        {% set attrs = {
            type: 'checkbox',
            class: 'form-check-input form-check-input-option',
            id: id,
            name: id,
            checked: checked,
            'data-default': checked|json_encode} %}
        <input {{ html_attr(attrs) }}>
        <label class="form-check-label" for="{{ id }}">{{ text|trans }}</label>
    </div>
{%- endmacro checkbox %}
{# parameters #}
{%- set title = 'test.notification' -%}
{%- set title_icon = 'fa-regular fa-bell' -%}
{# body #}
{% block card_body %}
    <span class="form-label horizontal-line mb-3 ">Type de message</span>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-1">
        {{ _self.button_notify('success', 'fa-solid fa-check-circle') }}
        {{ _self.button_notify('warning', 'fa-solid fa-exclamation-circle') }}
        {{ _self.button_notify('danger', 'fa-solid fa-exclamation-triangle') }}
        {{ _self.button_notify('info', 'fa-solid fa-info-circle') }}
        {{ _self.button_notify('primary', 'fa-regular fa-bell') }}
        {{ _self.button_notify('secondary', 'fa-regular fa-bell') }}
        {{ _self.button_notify('dark', 'fa-regular fa-bell') }}
    </div>
    <span class="form-label horizontal-line mt-3">Paramètres</span>
    <div class="row">
        <div class="col-md-6 col-lg-3 mb-3">
            {%- set selection = user_parameters.message.position %}
            {%- set positions = enum_sorted('App\\Enums\\MessagePosition') -%}
            {%- set attrs = {
                id: 'position',
                name: 'position',
                class: 'form-select',
                'data-default': selection.value,
                'data-random': url('ajax_random_text'),
                'data-failure': 'parameters.failure'|trans} -%}
            <label class="form-label" for="position">{{ 'parameters.fields.message_position'|trans }}</label>
            <select {{ html_attr(attrs) }}>
                {% for position in positions %}
                    {{ _self.position(position, selection) }}
                {% endfor %}
            </select>
        </div>
        <div class="col-md-6 col-lg-3 mb-3">
            {%- set selection = user_parameters.message.timeout -%}
            <label class="form-label" for="timeout">{{ 'parameters.fields.message_timeout'|trans }}</label>
            <select id="timeout" name="timeout" data-default="{{ selection }}" class="form-select">
                {% for seconds in 1..5 %}
                    {{ _self.timeout(seconds, selection) }}
                {% endfor %}
            </select>
        </div>
        <div class="col-md-6 col-lg-3 mb-3">
            {%- set selection = user_parameters.message.progress %}
            <label class="form-label" for="progress">{{ 'parameters.fields.message_progress'|trans }}</label>
            <select id="progress" name="progress" data-default="{{ selection }}" class="form-select">
                {% for i in 0..5 %}
                    {{ _self.progress(i, selection) }}
                {% endfor %}
            </select>
        </div>
        <div class="col-md-6 col-lg-3 mb-3">
            {%- set selection = 150 -%}
            <label class="form-label" for="maxNbChars">Nombre de caractères</label>
            <select id="maxNbChars" name="maxNbChars" data-default="{{ selection }}" class="form-select">
                {% for i in range(50, 500, 50) %}
                    <option value="{{ i }}"{% if i == selection %} selected{% endif %}>{{ i }}</option>
                {% endfor %}
            </select>
        </div>
    </div>
    <span class="form-label horizontal-line mb-3">{{ 'parameters.group_options'|trans }}</span>
    <div class="d-flex-wrap-center">
        {{ _self.checkbox('title', 'parameters.fields.message_title', user_parameters.message.title) }}
        {{ _self.checkbox('icon', 'parameters.fields.message_icon', user_parameters.message.icon) }}
        {{ _self.checkbox('subtitle', 'parameters.fields.message_sub_title', user_parameters.message.subTitle) }}
        {{ _self.checkbox('close', 'parameters.fields.message_close', user_parameters.message.close) }}
        {{ _self.checkbox('autohide', 'parameters.fields.message_auto_close') }}
    </div>
{% endblock card_body %}
{# footer #}
{% block card_footer %}
    {{ homepage() }}
    {{ button(
        text: 'parameters.default',
        class: 'btn btn-form btn-default btn-outline-success',
        icon: 'fa-solid fa-rotate-left',
        inline: false) }}
    <div class="btn-group btn-group-sm px-3 py-1" role="group" aria-label="{{ 'theme.help'|trans }}">
        {% set current = theme(app.request) %}
        {% for theme in themes() %}
            {% set attrs = {
                type: 'radio',
                class: 'btn-check',
                name: 'radio-theme',
                id: 'radio-theme-' ~ theme.value,
                value: theme.value,
                checked: theme == current,
                autocomplete: 'off',
                'data-success': theme.success|trans,
            } %}
            <input {{ html_attr(attrs) }}>
            {% set attrs = {
                title: theme|trans,
                for: 'radio-theme-' ~ theme.value,
                class: ['btn', 'btn-outline-secondary', loop.first ? 'rounded-start-pill'],
            } %}
            <label {{ html_attr(attrs) }}>
                <i class="{{ theme.icon }}"></i>
            </label>
        {% endfor %}
        {{ button(
            text: null,
            class: ['btn', 'btn-outline-secondary', 'rounded-end-pill', 'theme-switcher', 'ps-1'],
            icon: 'fa-solid fa-image',
            attributes: {
                title: 'theme.help'|trans,
                'data-url': path('theme_dialog'),
                'data-title': 'theme.title'|trans,
            },
        ) }}
    </div>
{% endblock card_footer %}
{# javascripts #}
{% block javascripts %}
    {{ parent() }}
    {{ asset_js('js/test/notification.js') }}
{%- endblock javascripts %}
