parameters:
    level: 8
    tmpDir: var/cache/phpstan
    paths:
        - src
        - tests
        - public

    checkDynamicProperties: true
    checkFunctionNameCase: true
    checkInternalClassCaseSensitivity: true
    checkMissingOverrideMethodAttribute: true
    checkTooWideParameterOutInProtectedAndPublicMethods: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkTooWideThrowTypesInProtectedAndPublicMethods: true
    checkUninitializedProperties: true

    polluteScopeWithBlock: true
    polluteScopeWithLoopInitialAssignments: true

    rememberPossiblyImpureFunctionValues: true

    reportAlwaysTrueInLastCondition: true
    reportMaybesInMethodSignatures: true
    reportMaybesInPropertyPhpDocTypes: true
    reportNonIntStringArrayKey: true
    reportStaticMethodSignatures: true
    reportUnmatchedIgnoredErrors: true

    doctrine:
    	allowNullablePropertyForRequiredField: true
    	ormRepositoryClass: App\Repository\AbstractRepository

    strictRules:
        strictArrayFilter: false

    dynamicConstantNames:
        - Symfony\Component\HttpKernel\Kernel::MINOR_VERSION

    type_coverage:
        constant: 100
        param: 99
        property: 100
        return: 100

    type_perfect:
        no_isset_on_object: true
        no_empty_on_object: true
        no_param_type_removal: true
        no_mixed_property: true
        no_mixed_caller: true
        narrow_param: true
        narrow_return: true

    ignoreErrors:
        -
            message: '#no value type specified#'
            identifier: missingType.iterableValue
        -
            message: '#Call to static method .* will always evaluate to true.#'
            path: tests/*
