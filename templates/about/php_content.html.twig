{% from 'about/_about_macro.html.twig' import headerLink %}
{# macros #}
{% macro output_entry_attr(entry, colspan = null) -%}
    {{- html_attr({
        colspan: colspan,
        class: [
            'v',
            entry.type === constant('App\\Service\\PhpInfoService::TYPE_DISABLED') ? 'disabled' : null,
            entry.type === constant('App\\Service\\PhpInfoService::TYPE_ENABLED') ? 'enabled' : null,
            entry.type === constant('App\\Service\\PhpInfoService::TYPE_NO_VALUE') ? 'text-secondary fst-italic' : null,
            entry.type === constant('App\\Service\\PhpInfoService::TYPE_NONE_VALUE') ? 'text-secondary' : null,
            entry.type === constant('App\\Service\\PhpInfoService::TYPE_REDACTED') ? 'text-secondary' : null,
        ],
        style: {
            color: entry.type === constant('App\\Service\\PhpInfoService::TYPE_COLOR') ? entry.value,
        },
    }) -}}
{%- endmacro output_entry_attr %}
{% macro output_group_configs(group) %}
    <table class="table table-sm table-hover">
        {% if group.headers %}
            <thead>
            <tr>
                {% for header in group.headers %}
                    <th class="{{ loop.index0 === 0 ? 'e' : 'v' }}">{{ header }}</th>
                {% endfor %}
            </tr>
            </thead>
        {% endif %}
        <tbody>
        {% for config in group.configs %}
            <tr>
                <td class="e">{{ config.name }}</td>
                <td {{ _self.output_entry_attr(config.local, config.master ? null : 2) }}>
                    {{- config.local.value|raw -}}
                </td>
                {% if config.master %}
                    <td {{ _self.output_entry_attr(config.master) }}>{{- config.master.value|raw -}}</td>
                {% endif %}
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endmacro output_group_configs %}
{# content #}
<div class="phpversion">
    {{ headerLink('php.net', info.version, 'php') }}
    <div id="php-accordion">
        {% for module in info.modules %}
            {% set index = loop.index0 %}
            {% set visible = index === 0 %}
            {% set header_id = 'module-header-' ~ index %}
            {% set module_id = 'module-content-' ~ index %}
            {% set attrs = {
                id: header_id,
                href: '#' ~ module_id,
                class: 'd-flex drop-down-icon-right fw-bold text-body py-1 mb-1 border-bottom',
                title: (visible ? 'common.collapse' : 'common.expand')|trans,
                'data-bs-toggle': 'collapse',
                'aria-controls': module_id,
                'aria-expanded': visible,
            } %}
            <a {{ html_attr(attrs) }}>
                <span class="flex-fill">{{ module.name }}</span>
                {% if module.size %}
                    <span class="badge rounded-pill text-bg-secondary lh-sm">{{ module.size }}</span>
                {% endif %}
            </a>
            {% set attrs = {
                id: module_id,
                class: ['collapse', 'ms-2', visible ? 'show' : null],
                'data-bs-parent': '#php-accordion',
                'aria-labelledby': header_id,
            } %}
            <div {{ html_attr(attrs) }}>
                {% for group in module.groups %}
                    {% if group.name %}
                        <div class="my-1 fw-bold">{{- group.name }}</div>
                    {% endif %}
                    {% if group.note %}
                        <div class="p-2 bg-body-tertiary small">{{ group.note|nl2br }}</div>
                    {% endif %}
                    {{ _self.output_group_configs(group) }}
                {% endfor %}
            </div>
        {% endfor %}
    </div>
</div>
