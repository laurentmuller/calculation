{# vendor/symfony/twig-bridge/Resources/views/Email/zurb_2/notification/body.html.twig #}
{% extends '@email/default/notification/body.html.twig' %}
{% set footer_text = 'notification.footer'|trans({'%app_name%': app_full_name}) %}
{# style #}
{% block style %}
    {{ parent() }}
    {{ source('@css/email.css') }}
{% endblock style %}
{# lead #}
{% block lead %}
    <container>
        <row>
            <columns large="1" small="3" valign="top">
                <img src="{{ email.image('@images/icons/favicon-48x48.png') }}" alt="{{ app_description }}">
            </columns>
            <columns large="11" small="9" valign="middle">
                {% if importance_title ?? false %}
                    <small><strong>{{ importance_title }}</strong></small>
                {% endif %}
                <p class="lead">{{- email.subject -}}</p>
            </columns>
        </row>
    </container>
{% endblock lead %}
{# action #}
{% block action %}
    {% if signature %}
        <spacer size="8"></spacer>
        Cordialement,<br>
        L'équipe de {{ app_name }}
    {% endif %}
    {{ parent() }}
{% endblock action %}
{# exception #}
{% block exception %}
    {% if exception %}
        <spacer size="16"></spacer>
        <p><em>{{ 'notification.exception'|trans }}</em></p>
    {% endif %}
{% endblock exception %}
