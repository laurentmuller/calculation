{% extends 'cards/card_base.html.twig' %}
{% from 'about/_about_macro.html.twig' import card, item_link_symfony, item_link_php, item_link_database %}
{% from 'macros/_icons.html.twig' import link, homepage, button, link_pdf, link_word %}
{# parameters #}
{%- set title = 'index.menu_info' -%}
{%- set title_icon = 'fa-solid fa-info-circle' -%}
{%- set title_parameters = {'%app_name%': app_name} -%}
{% set customer = application_parameters.customerInformation %}
{# class #}
{% block card_container_class '' %}
{% block card_header_class ' d-flex-wrap-center' %}
{% block card_footer_class ' d-none' %}
{# card title #}
{% block card_title %}
    {{ parent() }}
    {{ link_pdf('about_pdf') }}
    {{ link_word('about_word') }}
{%- endblock card_title %}
{# card body #}
{% block card_body %}
    {{ include('about/content_about.html.twig') }}
{% endblock card_body %}
{# body #}
{% block body %}
    {{ parent() }}
    <div class="card card-collapse" id="aboutAccordion">
        {{ card(id: 'licence', title: 'about.licence.title', pdf_route: 'about_licence_pdf', word_route: 'about_licence_word') }}
        {{ card(id: 'policy', title: 'about.policy.title', pdf_route: 'about_policy_pdf', word_route: 'about_policy_word') }}
    </div>
    <div class="d-flex-wrap-center mt-2 pb-3 d-print-none">
        {{ homepage() }}
        {{ link(
            href: path('user_comment'),
            text: 'user.comment.title',
            class: 'btn btn-form btn-success',
            icon: 'fa-regular fa-envelope',
            title: 'user.comment.description',
            inline: true) }}
        {% if is_granted(ROLE_ADMIN) %}
            {{ button(
                text: 'about.advanced.action',
                class: 'btn btn-outline-secondary dropdown-toggle',
                icon: 'fa-solid fa-screwdriver-wrench',
                attributes: {
                    title: 'about.advanced.title'|trans,
                    'data-bs-toggle': 'dropdown',
                    'aria-expanded': false,
                },
            ) }}
            <ul class="dropdown-menu">
                {{ item_link_symfony() }}
                {{ item_link_php() }}
                {{ item_link_database() }}
            </ul>
        {% endif %}
    </div>
{% endblock body %}
{# stylesheets #}
{% block stylesheets %}
    {{ asset_css('css/phpinfo.css') }}
{% endblock stylesheets %}
{# javascripts #}
{% block javascripts %}
    {% if is_js_debug %}
        {{ parent() }}
        {{ asset_js('build/clipboard/clipboard.js') }}
        {{ asset_js('js/plugins/plugin-copy.js') }}
        {{ asset_js('js/application/about_index.js') }}
    {%- else -%}
        {{ asset_js('js/compiled/about_index.js') }}
    {%- endif -%}
{% endblock javascripts %}
