{%- if route|default(false) and count > 0 -%}
    {%- set attrs = {
        class: 'rowlink-skip',
        href: path(route, parameters|default({})),
        title: title ? title|trans : null} -%}
    <a {{ html_attr(attrs) }}>{{ count|integer }}</a>
{%- else -%}
    {{- count|integer -}}
{%- endif -%}
