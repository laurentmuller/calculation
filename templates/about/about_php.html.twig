{% extends 'cards/card_base.html.twig' %}
{# import #}
{% from 'macros/_icons.html.twig' import homepage, link_pdf, link_excel %}
{% from 'about/_about_macro.html.twig' import about_link, button_toggle_split, item_link_symfony, item_link_database %}
{# parameters #}
{%- set title = 'about.php.title' -%}
{%- set title_icon = 'fa-brands fa-php' -%}
{# class #}
{% block card_container_class '' %}
{% block card_header_class ' d-flex-wrap-center' %}
{# card title #}
{% block card_title %}
    {{ parent() }}
    {{ link_pdf('about_php_pdf') }}
    {{ link_excel('about_php_excel') }}
{%- endblock card_title %}
{# card body #}
{% block card_body -%}
    {{ include('about/content_php.html.twig') }}
{% endblock card_body %}
{# card footer #}
{% block card_footer -%}
    {{ parent() }}
    {{ homepage() }}
    <div class="btn-group">
        {{ about_link() }}
        {{ button_toggle_split() }}
        <ul class="dropdown-menu">
            {{ item_link_symfony() }}
            {{ item_link_database() }}
        </ul>
    </div>
{%- endblock card_footer %}
{# stylesheets #}
{% block stylesheets %}
    {{ asset_css('css/phpinfo.css') }}
{% endblock stylesheets %}
